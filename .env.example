# HSBot Configuration
# Copy to .env and fill in your values

# App
APP_NAME=HSBot
APP_VERSION=1.0.0
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/hsbot.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/hsbot

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hsbot_docs

# NVIDIA NIM - Multiple keys can be comma-separated for automatic rotation
NVIDIA_API_KEYS=nvapi-key1,nvapi-key2
NVIDIA_DEFAULT_CHAT_MODEL=deepseek-v4-pro
NVIDIA_DEFAULT_CODE_MODEL=deepseek-coder
NVIDIA_DEFAULT_VISION_MODEL=llama-3.2-vision
NVIDIA_DEFAULT_IMAGE_MODEL=flux-kontext-dev
NVIDIA_DEFAULT_EMBED_MODEL=nv-embed-v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=

# LM Studio
LM_STUDIO_BASE_URL=http://localhost:1234

# File Processing
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,tauri://localhost
