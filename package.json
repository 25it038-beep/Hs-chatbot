{
  "name": "hsbot-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "description": "HSBot Multi-provider AI Assistant Workspace",
  "scripts": {
    "prebuild": "node scripts/install-native.cjs",
    "build": "npm --prefix frontend run build",
    "dev": "npm --prefix frontend run dev",
    "lint": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@types/ws": "^8.18.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.12",
    "@napi-rs/lzma-linux-x64-gnu": "1.5.1",
    "@rollup/rollup-linux-x64-gnu": "4.63.3",
    "@rollup/rollup-linux-x64-musl": "4.63.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  }
}
